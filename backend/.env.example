# Copy to .env and adjust. All settings use the RUG_ prefix.
RUG_DATABASE_URL=postgresql+psycopg://rug:rug@localhost:5432/rug
# Mounted NAS share; its top-level subfolders are the permission folders.
RUG_DOCS_DIR=/mnt/nas/documents

RUG_OLLAMA_URL=http://localhost:11434
RUG_EMBED_MODEL=nomic-embed-text
# Must match the database schema (768); a different size needs a migration + re-index.
RUG_EMBED_DIM=768
# nomic-embed-text task prefixes; set both empty for models that don't use them.
RUG_EMBED_DOC_PREFIX="search_document: "
RUG_EMBED_QUERY_PREFIX="search_query: "

# Chat model for answers and summaries. Check the tag exists: `ollama pull <tag>`.
RUG_CHAT_MODEL=qwen2.5:7b-instruct-q4_K_M
# Set on every request; keep RUG_CONTEXT_CHAR_BUDGET (~4 chars/token) well inside it.
RUG_CHAT_NUM_CTX=8192
RUG_CONTEXT_CHAR_BUDGET=16000   # whole prompt, in characters
RUG_MAX_QUESTION_CHARS=2000
RUG_RETRIEVAL_TOP_K=8
# Resolver thresholds were tuned on the synthetic corpus: re-check them on real filenames.
RUG_RESOLVER_ACCEPT_NAMED=0.75
RUG_RESOLVER_ACCEPT_ID=0.5
RUG_RESOLVER_MARGIN=0.12

RUG_CHUNK_CHARS=3200
RUG_CHUNK_OVERLAP=400
RUG_OCR_MIN_PX=100
# Per-file budgets: a document over them fails on its own instead of stalling the indexer.
RUG_MAX_UNCOMPRESSED_MB=512
RUG_MAX_IMAGES_PER_DOC=100
RUG_OCR_MAX_PIXELS=25000000
RUG_OCR_TIMEOUT_S=60

RUG_SCAN_INTERVAL_S=600
# Refuse scans that would delete more than this share of the catalog (unmounted NAS guard).
RUG_MAX_DELETE_FRACTION=0.5

# --- Sign-in (Active Directory) ------------------------------------------------------------
# Users are verified by binding as themselves; no service-account password is stored.
RUG_LDAP_URL=ldaps://dc1.corp.local
# ldap:// (no TLS) is refused unless RUG_LDAP_START_TLS=true or RUG_LDAP_ALLOW_INSECURE=true (dev only).
RUG_LDAP_START_TLS=false
RUG_LDAP_ALLOW_INSECURE=false
# PEM bundle that signed the domain controller's certificate (empty = system store).
RUG_LDAP_CA_CERTS_FILE=
RUG_LDAP_BASE_DN=dc=corp,dc=local
# Bind as CORP\user when the NetBIOS domain is set, else user@suffix.
RUG_LDAP_NETBIOS_DOMAIN=CORP
RUG_LDAP_UPN_SUFFIX=
# Members can manage folder access. Being an admin grants NO documents by itself.
RUG_LDAP_ADMIN_GROUP_DN=CN=RugAdmins,OU=Groups,DC=corp,DC=local

# --- Sessions and API ----------------------------------------------------------------------
# Required, at least 32 random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
RUG_SESSION_SECRET=
RUG_SESSION_TTL_S=28800
# Set false only for plain-http development.
RUG_COOKIE_SECURE=true
RUG_MAX_UPLOAD_MB=50
RUG_LOGIN_MAX_FAILURES_USER=5
RUG_LOGIN_MAX_FAILURES_IP=20
RUG_LOGIN_WINDOW_S=600
# Reverse-proxy addresses whose X-Forwarded-For is believed (JSON list), e.g. the Caddy container.
RUG_TRUSTED_PROXIES=[]
