# Copy to .env and adjust. All settings use the RUG_ prefix.
RUG_DATABASE_URL=postgresql+psycopg://rug:rug@localhost:5432/rug
# Mounted NAS share; its top-level subfolders are the permission folders.
RUG_DOCS_DIR=/mnt/nas/documents

RUG_OLLAMA_URL=http://localhost:11434
RUG_EMBED_MODEL=nomic-embed-text
RUG_EMBED_DIM=768
# nomic-embed-text task prefixes; set both empty for models that don't use them.
RUG_EMBED_DOC_PREFIX="search_document: "
RUG_EMBED_QUERY_PREFIX="search_query: "

RUG_CHUNK_CHARS=3200
RUG_CHUNK_OVERLAP=400
RUG_OCR_MIN_PX=100
RUG_SCAN_INTERVAL_S=600
