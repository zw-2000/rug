# Copy to .env (next to docker-compose.yml). .env is git-ignored; keep it that way.

# --- REQUIRED ---------------------------------------------------------------------------
# Letters and digits only (it is placed inside a database URL):  openssl rand -hex 24
POSTGRES_PASSWORD=
# 32+ random characters:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
RUG_SESSION_SECRET=
# The NAS share, already mounted on this host (see "NAS mount" in the README).
DOCS_DIR=/mnt/nas/documents
# The name people type in the browser (a DNS name or an IP address).
RUG_HOST=rug.corp.local

# --- Active Directory ---------------------------------------------------------------------
RUG_LDAP_URL=ldaps://dc1.corp.local
RUG_LDAP_BASE_DN=dc=corp,dc=local
RUG_LDAP_NETBIOS_DOMAIN=CORP
RUG_LDAP_ADMIN_GROUP_DN=CN=RugAdmins,OU=Groups,DC=corp,DC=local
# PEM of the CA that signed the domain controller's certificate, if it is not a public CA.
# Mount it into the app service and point this at it, e.g. /certs/ad-ca.pem
RUG_LDAP_CA_CERTS_FILE=

# --- Models (pulled once with: docker compose --profile setup run --rm ollama-pull) -------
RUG_CHAT_MODEL=qwen2.5:7b-instruct-q4_K_M
RUG_EMBED_MODEL=nomic-embed-text

# --- Optional -----------------------------------------------------------------------------
RUG_SCAN_INTERVAL_S=600
RUG_MAX_UPLOAD_MB=50
RUG_QA_RETENTION_DAYS=90
# Time zone for the backup schedule, e.g. Australia/Melbourne (default UTC).
TZ=UTC
# Backups: nightly at this time (in the zone above), newest N kept, written to this host folder.
BACKUP_AT=02:30
BACKUP_KEEP=14
BACKUP_DIR=./backups
